"use client";

import Link from "next/link";
import Image from "next/image";
import { useState } from "react";
import { Menu, X } from "lucide-react";

export const Navbar = () => {
  const [isOpen, setIsOpen] = useState(false);

  return (
    <nav className="bg-white border-b border-gray-100 sticky top-0 z-50">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex justify-between h-20 md:h-24 items-center">
          {/* Navigation & Actions (Left/Center) */}
          <div className="flex items-center gap-2 md:gap-4 flex-1">
            {/* Mobile Menu Button (Left on Mobile) */}
            <div className="xl:hidden">
              <button 
                onClick={() => setIsOpen(!isOpen)}
                className="text-brand-black p-1 hover:text-brand-purple transition-colors"
                aria-label="Toggle Menu"
              >
                {isOpen ? <X size={32} /> : <Menu size={32} />}
              </button>
            </div>

            {/* Desktop Links */}
            <div className="hidden xl:flex items-center gap-6">
              <Link href="/services" className="text-brand-charcoal hover:text-brand-purple transition-colors font-semibold text-sm uppercase tracking-wider">Services</Link>
              <Link href="/pricing" className="text-brand-charcoal hover:text-brand-purple transition-colors font-semibold text-sm uppercase tracking-wider">Pricing</Link>
              <Link href="/about" className="text-brand-charcoal hover:text-brand-purple transition-colors font-semibold text-sm uppercase tracking-wider">About</Link>
              <Link href="/resources" className="text-brand-charcoal hover:text-brand-purple transition-colors font-semibold text-sm uppercase tracking-wider">Resources</Link>
              <Link href="/faq" className="text-brand-charcoal hover:text-brand-purple transition-colors font-semibold text-sm uppercase tracking-wider">FAQ</Link>
              <Link href="/contact" className="text-brand-charcoal hover:text-brand-purple transition-colors font-semibold text-sm uppercase tracking-wider">Contact</Link>
            </div>

            <div className="hidden xl:block h-6 w-px bg-gray-200 mx-2" />

            {/* Actions */}
            <div className="flex items-center gap-2 md:gap-4">
              <Link 
                href="/portal" 
                className="bg-brand-black text-white px-3 md:px-5 py-2 md:py-2.5 rounded-xl font-bold hover:bg-brand-purple transition-all shadow-md flex items-center gap-2 text-xs md:text-sm whitespace-nowrap"
              >
                <span className="hidden sm:inline">Client</span> Portal
              </Link>
              
              <div className="hidden sm:flex items-center gap-4">
                <Link 
                  href="/auth/login" 
                  className="text-brand-purple font-bold hover:text-brand-black transition-colors text-sm"
                >
                  Login
                </Link>
                <Link
                  href="/auth/signup"
                  className="bg-brand-purple text-white px-6 py-2.5 rounded-xl font-bold hover:bg-[#5a3a74] transition-all shadow-sm text-sm"
                >
                  Start Intake
                </Link>
              </div>
            </div>
          </div>

          {/* Logo (Right on All Screens) */}
          <div className="flex items-center justify-end ml-4">
            <Link href="/" className="flex items-center group">
              <Image 
                src="/images/logo-long.png" 
                alt="Your Tax Source Logo" 
                width={280} 
                height={80} 
                className="h-12 sm:h-14 md:h-20 w-auto object-contain transition-transform group-hover:scale-105"
                priority
              />
              <span className="sr-only">Your Tax Source</span>
            </Link>
          </div>
        </div>
      </div>

      {/* Mobile Navigation */}
      {isOpen && (
        <div className="xl:hidden bg-white border-t border-gray-100 py-6 px-4 animate-in slide-in-from-top duration-300">
          <div className="flex flex-col gap-4">
            <Link href="/services" onClick={() => setIsOpen(false)} className="text-brand-charcoal hover:text-brand-purple font-bold text-lg">Services</Link>
            <Link href="/pricing" onClick={() => setIsOpen(false)} className="text-brand-charcoal hover:text-brand-purple font-bold text-lg">Pricing</Link>
            <Link href="/about" onClick={() => setIsOpen(false)} className="text-brand-charcoal hover:text-brand-purple font-bold text-lg">About</Link>
            <Link href="/resources" onClick={() => setIsOpen(false)} className="text-brand-charcoal hover:text-brand-purple font-bold text-lg">Resources</Link>
            <Link href="/faq" onClick={() => setIsOpen(false)} className="text-brand-charcoal hover:text-brand-purple font-bold text-lg">FAQ</Link>
            <Link href="/contact" onClick={() => setIsOpen(false)} className="text-brand-charcoal hover:text-brand-purple font-bold text-lg">Contact</Link>
            <hr className="border-gray-100" />
            <Link href="/portal" onClick={() => setIsOpen(false)} className="bg-brand-black text-white px-4 py-3 rounded-xl font-bold text-center">Client Portal</Link>
            <Link href="/auth/signup" onClick={() => setIsOpen(false)} className="bg-brand-purple text-white px-4 py-3 rounded-xl font-bold text-center">Start Intake</Link>
            <Link href="/auth/login" onClick={() => setIsOpen(false)} className="text-brand-purple font-bold text-center">Login</Link>
          </div>
        </div>
      )}
